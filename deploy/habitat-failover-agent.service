[Unit]
Description=Habitat failover node agent
After=network.target docker.service

[Service]
Type=simple
User=adhiraj
SupplementaryGroups=docker
WorkingDirectory=/home/adhiraj/projects/habitat-failover
Environment=PYTHONPATH=/home/adhiraj/projects/habitat-failover/src
EnvironmentFile=/etc/habitat-failover/agent.env
ExecStart=/home/adhiraj/projects/habitat-failover/.venv/bin/python -m habitat_failover.agent --config /etc/habitat-failover/agent.json --host 127.0.0.1 --port 6720
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
