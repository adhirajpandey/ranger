# Worker secrets, uploaded with `pywrangler deploy --secrets-file`.
# DNS Read and DNS Edit on the workloads' zone.
DNS_API_TOKEN=replace-with-a-cloudflare-api-token
# The same value as each agent's AGENT_TOKEN. Generate with `openssl rand -hex 32`.
AGENT_TOKEN=replace-with-64-hex-characters
# Bearer token for GET /status. Generate with `openssl rand -hex 32`.
STATUS_TOKEN=replace-with-64-hex-characters
